# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prohire_db?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# Alibaba Cloud DashScope (Qwen models + embeddings)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Set to "mock" to use the built-in mock LLM provider (no API key needed, for early dev)
LLM_PROVIDER=mock
